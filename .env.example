# Frontend Environment Variables (Safe for browser / client exposure)
# Replace with your actual deployed n8n Cloud webhook endpoints
VITE_N8N_WEATHER_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/tsukuyomi/weather-score
VITE_N8N_GEOCODE_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/tsukuyomi/geocode
VITE_N8N_EVENTS_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/tsukuyomi/events

# App Execution Mode: 'live' or 'demo'
VITE_APP_MODE=live

# Backend API Keys & Endpoints (from API Requirements Table)
NASA_API_KEY=your_nasa_api_key_here
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODE_URL=https://geocoding-api.open-meteo.com/v1/search
CARTO_BASEMAP_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
SPACE_LAUNCH_API_URL=https://ll.thespacedevs.com/2.2.0/launch/upcoming/
NASA_APOD_URL=https://api.nasa.gov/planetary/apod
NASA_SKYVIEW_URL=https://skyview.gsfc.nasa.gov/current/cgi/runquery.pl
METEOR_SHOWER_API_URL=https://meteorshowercal.com/api
N2YO_API_KEY=your_n2yo_api_key_optional
